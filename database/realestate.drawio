<mxfile host="Electron">
  <diagram name="Page-1" id="IfVz9jFPHw6IXPBt98m0">
    <mxGraphModel dx="3190" dy="2060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\nskinparam class {\n    BorderThickness 1.5\n    ArrowColor #424242\n    FontColor #212121\n}\n\n&#39; ===== STAKEHOLDERS (Blue) =====\nentity landlords #E3F2FD {\n    * landlord_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * landlord_type : ENUM(&#39;INDIVIDUAL&#39;,&#39;COMPANY&#39;,&#39;TRUST&#39;)\n    * full_name / company_name : VARCHAR(200)\n    * national_id / reg_number : VARCHAR(50) &lt;&lt;UQ&gt;&gt;\n    * tax_number : VARCHAR(50)\n    * phone_primary : VARCHAR(20)\n    * phone_secondary : VARCHAR(20)\n    * email : VARCHAR(255)\n    * address : TEXT\n    * bank_account : VARCHAR(100)\n    * bank_name : VARCHAR(100)\n    * is_active : BOOLEAN &lt;&lt;DF TRUE&gt;&gt;\n    * created_at : TIMESTAMPTZ\n}\n\nentity property_managers #E3F2FD {\n    * manager_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * full_name : VARCHAR(200)\n    * national_id : VARCHAR(50) &lt;&lt;UQ&gt;&gt;\n    * phone : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * email : VARCHAR(255) &lt;&lt;UQ&gt;&gt;\n    * commission_rate : DECIMAL(5,4)\n    * license_number : VARCHAR(50)\n    * territory : VARCHAR(100)\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMPTZ\n}\n\nentity tenants #E3F2FD {\n    * tenant_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * full_name : VARCHAR(200)\n    * national_id : VARCHAR(50)\n    * phone_primary : VARCHAR(20)\n    * phone_secondary : VARCHAR(20)\n    * email : VARCHAR(255)\n    * employer_name : VARCHAR(200)\n    * employer_contact : VARCHAR(20)\n    * monthly_income : DECIMAL(18,2)\n    * emergency_contact_name : VARCHAR(200)\n    * emergency_contact_phone : VARCHAR(20)\n    * credit_score : INT\n    * blacklist_status : ENUM(&#39;CLEAR&#39;,&#39;FLAGGED&#39;,&#39;BLACKLISTED&#39;)\n    * created_at : TIMESTAMPTZ\n}\n\nentity tenant_guarantors #E3F2FD {\n    * guarantor_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * tenant_id : UUID &lt;&lt;FK&gt;&gt;\n    * full_name : VARCHAR(200)\n    * national_id : VARCHAR(50)\n    * phone : VARCHAR(20)\n    * email : VARCHAR(255)\n    * relationship : VARCHAR(50)\n    * employer_name : VARCHAR(200)\n    * monthly_income : DECIMAL(18,2)\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMPTZ\n}\n\n&#39; ===== PROPERTIES (Green) =====\nentity properties #E8F5E9 {\n    * property_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * landlord_id : UUID &lt;&lt;FK&gt;&gt;\n    * manager_id : UUID &lt;&lt;FK&gt;&gt;\n    * property_code : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * property_name : VARCHAR(200)\n    * property_type : ENUM(&#39;APARTMENT_BLOCK&#39;,&#39;HOUSE&#39;,&#39;TOWNHOUSE&#39;,&#39;OFFICE&#39;,&#39;RETAIL&#39;,&#39;INDUSTRIAL&#39;,&#39;MIXED_USE&#39;)\n    * address_line_1 : VARCHAR(255)\n    * address_line_2 : VARCHAR(255)\n    * city : VARCHAR(100)\n    * suburb : VARCHAR(100)\n    * council_zone : VARCHAR(50)\n    * stand_number : VARCHAR(50)\n    * deed_number : VARCHAR(100)\n    * total_units : INT\n    * year_built : INT\n    * description : TEXT\n    * amenities : JSONB\n    * status : ENUM(&#39;ACTIVE&#39;,&#39;UNDER_RENOVATION&#39;,&#39;INACTIVE&#39;)\n    * created_at : TIMESTAMPTZ\n}\n\nentity property_documents #E8F5E9 {\n    * document_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * property_id : UUID &lt;&lt;FK&gt;&gt;\n    * document_type : ENUM(&#39;TITLE_DEED&#39;,&#39;COUNCIL_CERT&#39;,&#39;INSURANCE&#39;,&#39;BLUEPRINT&#39;,&#39;PHOTO&#39;)\n    * file_path : VARCHAR(500)\n    * file_hash : VARCHAR(64)\n    * uploaded_by : UUID\n    * uploaded_at : TIMESTAMPTZ\n}\n\nentity units #E8F5E9 {\n    * unit_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * property_id : UUID &lt;&lt;FK&gt;&gt;\n    * unit_number : VARCHAR(20)\n    * unit_type : ENUM(&#39;STUDIO&#39;,&#39;1_BED&#39;,&#39;2_BED&#39;,&#39;3_BED&#39;,&#39;4_BED_PLUS&#39;,&#39;OFFICE&#39;,&#39;SHOP&#39;,&#39;WAREHOUSE&#39;)\n    * floor_level : INT\n    * square_metres : DECIMAL(8,2)\n    * bedrooms : INT\n    * bathrooms : INT\n    * furnished : BOOLEAN &lt;&lt;DF FALSE&gt;&gt;\n    * amenities : JSONB\n    * current_rent : DECIMAL(18,2)\n    * rent_currency : CHAR(3) &lt;&lt;DF &#39;USD&#39;&gt;&gt;\n    * deposit_months : INT &lt;&lt;DF 1&gt;&gt;\n    * status : ENUM(&#39;VACANT&#39;,&#39;OCCUPIED&#39;,&#39;UNDER_MAINTENANCE&#39;,&#39;RESERVED&#39;)\n    * created_at : TIMESTAMPTZ\n    --\n    &lt;&lt;UQ&gt;&gt; (property_id, unit_number)\n}\n\n&#39; ===== LEASES (Red) =====\nentity leases #FFEBEE {\n    * lease_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * lease_number : VARCHAR(50) &lt;&lt;UQ&gt;&gt;\n    * unit_id : UUID &lt;&lt;FK&gt;&gt;\n    * primary_tenant_id : UUID &lt;&lt;FK&gt;&gt;\n    * lease_type : ENUM(&#39;FIXED_TERM&#39;,&#39;MONTH_TO_MONTH&#39;,&#39;COMMERCIAL&#39;)\n    * start_date : DATE\n    * end_date : DATE\n    * base_rent : DECIMAL(18,2)\n    * rent_currency : CHAR(3) &lt;&lt;DF &#39;USD&#39;&gt;&gt;\n    * deposit_amount : DECIMAL(18,2)\n    * deposit_currency : CHAR(3)\n    * deposit_held_at : UUID\n    * payment_due_day : INT &lt;&lt;DF 1&gt;&gt;\n    * late_fee_amount : DECIMAL(18,2)\n    * late_fee_grace_days : INT &lt;&lt;DF 7&gt;&gt;\n    * notice_period_days : INT &lt;&lt;DF 30&gt;&gt;\n    * escalation_type : ENUM(&#39;FIXED&#39;,&#39;PERCENTAGE&#39;,&#39;MARKET_RATE&#39;)\n    * escalation_value : DECIMAL(8,4)\n    * escalation_frequency_months : INT &lt;&lt;DF 12&gt;&gt;\n    * includes_water : BOOLEAN &lt;&lt;DF FALSE&gt;&gt;\n    * includes_zesa : BOOLEAN &lt;&lt;DF FALSE&gt;&gt;\n    * includes_rates : BOOLEAN &lt;&lt;DF FALSE&gt;&gt;\n    * status : ENUM(&#39;DRAFT&#39;,&#39;ACTIVE&#39;,&#39;EXPIRING&#39;,&#39;RENEWED&#39;,&#39;TERMINATED&#39;,&#39;BREACHED&#39;)\n    * termination_date : DATE\n    * termination_reason : TEXT\n    * created_at : TIMESTAMPTZ\n}\n\nentity lease_tenants #FFEBEE {\n    * lease_tenant_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * lease_id : UUID &lt;&lt;FK&gt;&gt;\n    * tenant_id : UUID &lt;&lt;FK&gt;&gt;\n    * is_primary : BOOLEAN &lt;&lt;DF FALSE&gt;&gt;\n    * move_in_date : DATE\n    * move_out_date : DATE\n    * created_at : TIMESTAMPTZ\n}\n\nentity lease_escalations #FFEBEE {\n    * escalation_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * lease_id : UUID &lt;&lt;FK&gt;&gt;\n    * effective_date : DATE\n    * previous_rent : DECIMAL(18,2)\n    * new_rent : DECIMAL(18,2)\n    * currency_code : CHAR(3)\n    * reason : TEXT\n    * notified_at : TIMESTAMPTZ\n    * created_at : TIMESTAMPTZ\n}\n\nentity lease_documents #FFEBEE {\n    * doc_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * lease_id : UUID &lt;&lt;FK&gt;&gt;\n    * document_type : ENUM(&#39;LEASE_AGREEMENT&#39;,&#39;INVENTORY_LIST&#39;,&#39;CONDITION_REPORT&#39;,&#39;GUARANTOR_DEED&#39;)\n    * file_path : VARCHAR(500)\n    * signed_by_landlord_at : TIMESTAMPTZ\n    * signed_by_tenant_at : TIMESTAMPTZ\n    * uploaded_at : TIMESTAMPTZ\n}\n\n&#39; ===== PAYMENTS (Amber) =====\nentity payment_schedules #FFF8E1 {\n    * schedule_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * lease_id : UUID &lt;&lt;FK&gt;&gt;\n    * due_date : DATE\n    * amount_due : DECIMAL(18,2)\n    * currency_code : CHAR(3)\n    * description : VARCHAR(255)\n    * status : ENUM(&#39;PENDING&#39;,&#39;PAID&#39;,&#39;OVERDUE&#39;,&#39;WAIVED&#39;)\n    * paid_amount : DECIMAL(18,2)\n    * paid_at : TIMESTAMPTZ\n    * created_at : TIMESTAMPTZ\n}\n\nentity rent_payments #FFF8E1 {\n    * payment_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * lease_id : UUID &lt;&lt;FK&gt;&gt;\n    * schedule_id : UUID &lt;&lt;FK&gt;&gt;\n    * payment_method : ENUM(&#39;CASH&#39;,&#39;BANK_TRANSFER&#39;,&#39;ECOCASH&#39;,&#39;ZIPIT&#39;,&#39;SWIPE&#39;,&#39;USD_CASH&#39;,&#39;ZiG_CASH&#39;)\n    * currency_code : CHAR(3)\n    * amount_paid : DECIMAL(18,2)\n    * exchange_rate : DECIMAL(24,10)\n    * base_currency_amount : DECIMAL(18,2)\n    * reference_number : VARCHAR(100)\n    * period_from : DATE\n    * period_to : DATE\n    * late_fee_applied : DECIMAL(18,2)\n    * receipt_number : VARCHAR(50) &lt;&lt;UQ&gt;&gt;\n    * received_by : UUID\n    * payment_date : TIMESTAMPTZ\n    * reconciled : BOOLEAN &lt;&lt;DF FALSE&gt;&gt;\n    * notes : TEXT\n    * created_at : TIMESTAMPTZ\n}\n\nentity deposits #FFF8E1 {\n    * deposit_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * lease_id : UUID &lt;&lt;FK&gt;&gt;\n    * amount : DECIMAL(18,2)\n    * currency_code : CHAR(3)\n    * held_by : ENUM(&#39;LANDLORD&#39;,&#39;AGENT&#39;,&#39;ESCROW&#39;)\n    * status : ENUM(&#39;HELD&#39;,&#39;PARTIAL_RETURNED&#39;,&#39;FULLY_RETURNED&#39;,&#39;FORFEITED&#39;)\n    * interest_accrued : DECIMAL(18,2)\n    * created_at : TIMESTAMPTZ\n}\n\nentity deposit_transactions #FFF8E1 {\n    * txn_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * deposit_id : UUID &lt;&lt;FK&gt;&gt;\n    * transaction_type : ENUM(&#39;DEDUCTION&#39;,&#39;REFUND&#39;,&#39;INTEREST&#39;)\n    * amount : DECIMAL(18,2)\n    * currency_code : CHAR(3)\n    * reason : TEXT\n    * related_expense_id : UUID\n    * processed_at : TIMESTAMPTZ\n    * created_at : TIMESTAMPTZ\n}\n\n&#39; ===== MAINTENANCE (Orange) =====\nentity maintenance_categories #FFE0B2 {\n    * category_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * category_name : VARCHAR(100)\n    * description : TEXT\n    * default_priority : ENUM(&#39;LOW&#39;,&#39;MEDIUM&#39;,&#39;HIGH&#39;,&#39;EMERGENCY&#39;)\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMPTZ\n}\n\nentity maintenance_requests #FFE0B2 {\n    * request_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * lease_id : UUID &lt;&lt;FK&gt;&gt;\n    * unit_id : UUID &lt;&lt;FK&gt;&gt;\n    * category_id : UUID &lt;&lt;FK&gt;&gt;\n    * title : VARCHAR(255)\n    * description : TEXT\n    * priority : ENUM(&#39;LOW&#39;,&#39;MEDIUM&#39;,&#39;HIGH&#39;,&#39;EMERGENCY&#39;)\n    * status : ENUM(&#39;OPEN&#39;,&#39;ASSIGNED&#39;,&#39;IN_PROGRESS&#39;,&#39;PENDING_PARTS&#39;,&#39;COMPLETED&#39;,&#39;CANCELLED&#39;)\n    * reported_by : UUID\n    * reported_at : TIMESTAMPTZ\n    * assigned_to : UUID\n    * assigned_at : TIMESTAMPTZ\n    * completed_at : TIMESTAMPTZ\n    * tenant_satisfaction : INT\n    * estimated_cost : DECIMAL(18,2)\n    * actual_cost : DECIMAL(18,2)\n    * currency_code : CHAR(3)\n    * created_at : TIMESTAMPTZ\n}\n\nentity maintenance_photos #FFE0B2 {\n    * photo_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * request_id : UUID &lt;&lt;FK&gt;&gt;\n    * photo_type : ENUM(&#39;BEFORE&#39;,&#39;DURING&#39;,&#39;AFTER&#39;)\n    * file_path : VARCHAR(500)\n    * uploaded_by : UUID\n    * uploaded_at : TIMESTAMPTZ\n}\n\n&#39; ===== INSPECTIONS (Teal) =====\nentity inspections #E0F2F1 {\n    * inspection_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * lease_id : UUID &lt;&lt;FK&gt;&gt;\n    * unit_id : UUID &lt;&lt;FK&gt;&gt;\n    * inspection_type : ENUM(&#39;MOVE_IN&#39;,&#39;MOVE_OUT&#39;,&#39;PERIODIC&#39;,&#39;EMERGENCY&#39;)\n    * scheduled_date : DATE\n    * conducted_date : TIMESTAMPTZ\n    * conducted_by : UUID\n    * tenant_present : BOOLEAN\n    * overall_condition : ENUM(&#39;EXCELLENT&#39;,&#39;GOOD&#39;,&#39;FAIR&#39;,&#39;POOR&#39;,&#39;DAMAGED&#39;)\n    * notes : TEXT\n    * tenant_signature : VARCHAR(500)\n    * inspector_signature : VARCHAR(500)\n    * created_at : TIMESTAMPTZ\n}\n\nentity inspection_items #E0F2F1 {\n    * item_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * inspection_id : UUID &lt;&lt;FK&gt;&gt;\n    * area : VARCHAR(100)\n    * item_name : VARCHAR(255)\n    * condition_in : ENUM(&#39;EXCELLENT&#39;,&#39;GOOD&#39;,&#39;FAIR&#39;,&#39;POOR&#39;,&#39;DAMAGED&#39;,&#39;MISSING&#39;)\n    * condition_out : ENUM(&#39;EXCELLENT&#39;,&#39;GOOD&#39;,&#39;FAIR&#39;,&#39;POOR&#39;,&#39;DAMAGED&#39;,&#39;MISSING&#39;)\n    * photos : JSONB\n    * notes : TEXT\n    * repair_cost_estimate : DECIMAL(18,2)\n    * currency_code : CHAR(3)\n    * created_at : TIMESTAMPTZ\n}\n\n&#39; ===== EXPENSES (Purple) =====\nentity expense_categories #F3E5F5 {\n    * category_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * category_name : VARCHAR(100)\n    * description : TEXT\n    * is_tax_deductible : BOOLEAN\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMPTZ\n}\n\nentity expenses #F3E5F5 {\n    * expense_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * property_id : UUID &lt;&lt;FK&gt;&gt;\n    * unit_id : UUID &lt;&lt;FK&gt;&gt;\n    * category_id : UUID &lt;&lt;FK&gt;&gt;\n    * expense_type : ENUM(&#39;COUNCIL_RATES&#39;,&#39;ZESA&#39;,&#39;WATER&#39;,&#39;INSURANCE&#39;,&#39;MAINTENANCE&#39;,&#39;SECURITY&#39;,&#39;GARDENING&#39;,&#39;OTHER&#39;)\n    * description : TEXT\n    * amount : DECIMAL(18,2)\n    * currency_code : CHAR(3)\n    * vat_amount : DECIMAL(18,2)\n    * supplier_name : VARCHAR(200)\n    * invoice_number : VARCHAR(50)\n    * invoice_date : DATE\n    * paid_date : DATE\n    * allocated_to_lease_id : UUID\n    * is_recoverable_from_tenant : BOOLEAN\n    * recovered_amount : DECIMAL(18,2)\n    * created_at : TIMESTAMPTZ\n}\n\n&#39; ===== COMMUNICATIONS (Indigo) =====\nentity notifications #E8EAF6 {\n    * notification_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * recipient_type : ENUM(&#39;TENANT&#39;,&#39;LANDLORD&#39;,&#39;MANAGER&#39;)\n    * recipient_id : UUID\n    * notification_type : ENUM(&#39;RENT_DUE&#39;,&#39;LEASE_EXPIRING&#39;,&#39;MAINTENANCE_UPDATE&#39;,&#39;INSPECTION_SCHEDULED&#39;,&#39;PAYMENT_RECEIVED&#39;,&#39;LATE_NOTICE&#39;)\n    * channel : ENUM(&#39;SMS&#39;,&#39;EMAIL&#39;,&#39;WHATSAPP&#39;,&#39;IN_APP&#39;)\n    * subject : VARCHAR(255)\n    * body : TEXT\n    * sent_at : TIMESTAMPTZ\n    * delivered_at : TIMESTAMPTZ\n    * read_at : TIMESTAMPTZ\n    * status : ENUM(&#39;PENDING&#39;,&#39;SENT&#39;,&#39;DELIVERED&#39;,&#39;FAILED&#39;)\n    * created_at : TIMESTAMPTZ\n}\n\n&#39; ===== AUDIT (Gray) =====\nentity audit_logs #F5F5F5 {\n    * log_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n    --\n    * user_id : UUID\n    * action : VARCHAR(100)\n    * entity_type : VARCHAR(50)\n    * entity_id : UUID\n    * old_values : JSONB\n    * new_values : JSONB\n    * ip_address : INET\n    * user_agent : TEXT\n    * created_at : TIMESTAMPTZ\n}\n\n&#39; ===== RELATIONSHIPS =====\nlandlords ||--o{ properties : owns\nproperty_managers ||--o{ properties : manages\n\nproperties ||--o{ property_documents\nproperties ||--o{ units : contains\nproperties ||--o{ expenses : incurs\n\nunits ||--o{ leases : has\nunits ||--o{ maintenance_requests : subject_of\nunits ||--o{ inspections : inspected\nunits ||--o{ expenses : specific_to\n\ntenants ||--o{ tenant_guarantors\ntenants ||--o{ lease_tenants\ntenants ||--o{ maintenance_requests : reports\n\nleases ||--o{ lease_tenants\nleases ||--o{ lease_escalations\nleases ||--o{ lease_documents\nleases ||--o{ payment_schedules\nleases ||--o{ rent_payments\nleases ||--o{ deposits\nleases ||--o{ maintenance_requests\nleases ||--o{ inspections\nleases ||--o{ expenses : allocated_to\n\ndeposits ||--o{ deposit_transactions\n\nmaintenance_categories ||--o{ maintenance_requests\nmaintenance_requests ||--o{ maintenance_photos\n\ninspections ||--o{ inspection_items\n\nexpense_categories ||--o{ expenses\n\nnote right of properties\n  **Zimbabwe-Specific Fields**\n  - council_zone: for Harare/Bulawayo municipal rates\n  - stand_number: Deeds Registry reference\n  - deed_number: official title deed number\n  - Multi-currency support throughout (USD/ZiG)\nend note\n\nnote right of leases\n  **Lease Escalation Logic**\n  - escalation_type: FIXED amount or PERCENTAGE\n  - escalation_frequency_months: typically 12\n  - Automated schedule generation on creation\n  - includes_* flags for utility allocations\nend note\n\nnote right of rent_payments\n  **Multi-Currency Handling**\n  - amount_paid in tendered currency\n  - base_currency_amount in reporting currency\n  - Supports USD cash, ZiG cash, Ecocash, Zipit\n  - receipt_number for ZIMRA/audit trail\nend note\n\nnote right of maintenance_requests\n  **Ticketing Workflow**\n  - EMERGENCY: burst geyser, electrical fault\n  - Tenant reports → Manager assigns → Contractor fixes\n  - Photo evidence required before/after\n  - Cost tracked per request for landlord recovery\nend note\n\nnote bottom of units\n  **Recommended PostgreSQL Indexes**\n  - units(property_id, status)\n  - units(status, rent_currency, current_rent)\n  - leases(unit_id, status, start_date, end_date)\n  - leases(primary_tenant_id, status)\n  - payment_schedules(lease_id, due_date, status)\n  - rent_payments(lease_id, payment_date)\n  - rent_payments(receipt_number)\n  - maintenance_requests(unit_id, status, priority)\n  - maintenance_requests(assigned_to, status)\n  - inspections(unit_id, inspection_type, conducted_date)\n  - expenses(property_id, expense_type, invoice_date)\n  - notifications(recipient_id, status, created_at)\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="df8CfSnIWUZFsO7AyKPg-1">
